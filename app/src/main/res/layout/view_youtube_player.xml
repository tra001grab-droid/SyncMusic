<?xml version="1.0" encoding="utf-8"?>
<!-- Used to rebuild a YouTube player in code after its WebView's renderer died; automatic
     initialization must stay off because YouTubeSyncPlayer initializes it itself. -->
<com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:enableAutomaticInitialization="false" />
