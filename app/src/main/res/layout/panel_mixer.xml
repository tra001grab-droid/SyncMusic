<?xml version="1.0" encoding="utf-8"?>
<!-- 🎚 Mixer: volume and EQ for this phone, or (on the host) for any connected phone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0F0F0F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎚 Mixer — សំឡេង &amp; EQ"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/mixerClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Host only: every phone as a track, its gap to the host on a shared scale. -->
            <LinearLayout
                android:id="@+id/mixerTracksSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <!-- ✋ Stop measuring: every phone keeps playing on its own, no more corrections. -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/mixerHold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="✋ ឈប់វាស់"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 Sync Tracks — គម្លាតធៀបនឹងទូរស័ព្ទមេ"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- 🤖 Auto delay: measure each phone with the host's microphone. -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/mixerAutoDelay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="🤖 Auto"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mixerAutoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mixerAutoStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#80CBC4"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/mixerAutoRun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 វាស់ម្ដងទៀត"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Options of the microphone measurement (shown with 🤖 Auto). -->
                <LinearLayout
                    android:id="@+id/mixerAutoOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/mixerSilent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔇 ប៊ិបស្ងាត់ (19 kHz)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/mixerListener"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="false"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 🎧 By ear: for earphones / broken microphones. Every phone beeps together. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mixerEarStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ពាក់កាស ឬ Microphone ខូច? វាស់ដោយត្រចៀក →"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/mixerEar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎧 វាស់ដោយត្រចៀក"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- 🎯 Line every phone's cursor (song position) up with the host's, once. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mixerAlignStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ទីតាំងបទ (cursor) របស់ទូរស័ព្ទនីមួយៗ ខាងក្រោម →"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/mixerAlign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Auto cursor"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mixerTracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!--
                The controls for one phone. On the host they stay hidden until a track is tapped,
                and then open right under that track (moved there in code).
            -->
            <LinearLayout
                android:id="@+id/mixerControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1F26"
                android:padding="8dp"
                android:orientation="vertical">

            <TextView
                android:id="@+id/mixerLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="◀ យឺតជាង Host · | Host · លឿនជាង Host ▶   (±300 ms)\n🟢 ≤60 ms  🟡 ≤150 ms  🔴 លើសនេះ — កែតាម ⏱ Delay ខាងក្រោម"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Client with nothing else: which phone the controls below apply to. Filled in code. -->
            <HorizontalScrollView
                android:id="@+id/mixerDevicesScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/mixerDevices"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/mixerVolumeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:text="🔊 Volume"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/mixerVolume"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:max="200" />

                <Button
                    android:id="@+id/mixerMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="🔇 Mute" />
            </LinearLayout>

            <!-- Safety lock for 101-200%: protects the phone's speaker. -->
            <Button
                android:id="@+id/mixerBoostLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false" />

            <!-- Per-phone sound delay, set by ear until every phone sounds together. -->
            <LinearLayout
                android:id="@+id/mixerDelaySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mixerDelayLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/mixerDelayMinus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="− 10" />

                    <SeekBar
                        android:id="@+id/mixerDelay"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:max="100" />

                    <Button
                        android:id="@+id/mixerDelayPlus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="+ 10" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ទូរស័ព្ទនេះលឺយឺតជាងគេ (ឧ. ឧបាល័រ Bluetooth) → ចុច ＋\nទូរស័ព្ទនេះលឺលឿនជាងគេ → ចុច −\nកែបន្តិចម្ដងៗ រហូតដល់លឺស៊ីគ្នា។"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:text="🎛 Equalizer"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/mixerPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- One row per band: label, slider (-12..+12 dB), value. Filled in code. -->
            <LinearLayout
                android:id="@+id/mixerBands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/mixerNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
