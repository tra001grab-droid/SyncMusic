<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Room for the search header (which floats above, see the end of this file). -->
    <View
        android:id="@+id/searchHeaderSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ជ្រើសរើស៖ ធ្វើជា Host ឬ ចូលរួម"
        android:textSize="15sp"
        android:paddingBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="▶ ចាក់ YouTube បន្ត ពេលបិទអេក្រង់"
        android:textSize="14sp" />

    <!-- Wait for 20% before playing YouTube (and preload the next song). -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchPreload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="► ធ្វើអោយភ្លេងរត់ត្រូវគ្នា"
        android:textSize="14sp" />

    <!-- Mode selection -->
    <LinearLayout
        android:id="@+id/modePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 ធ្វើជា Host (ទូរស័ព្ទមេ)" />

        <Button
            android:id="@+id/btnJoin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 ចូលរួម (ស្វែងរក Host ដោយស្វ័យប្រវត្តិ)" />

        <EditText
            android:id="@+id/manualAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ឬ វាយ IP:port របស់ Host (ឧ. 192.168.1.5:40000)"
            android:inputType="text" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ភ្ជាប់ដោយដៃ" />
    </LinearLayout>

    <TextView
        android:id="@+id/nowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Room for the player, which floats above the page (see playerContainer below) so it can
         slide away, shrink to a mini player or go fullscreen without moving its web views. -->
    <View
        android:id="@+id/playerSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Host playback controls: right under the player so they stay visible in the playlist,
         in search and in fullscreen. -->
    <LinearLayout
        android:id="@+id/hostControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#222222"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="⏮"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnBack5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="⏪5s"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="▶"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="⏸"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnForward5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="5s⏩"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="⏭"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Host controls + playlist -->
    <LinearLayout
        android:id="@+id/hostPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:text="🔁 Auto play (ចាក់បទបន្ទាប់ដោយស្វ័យប្រវត្តិ)" />

        <Button
            android:id="@+id/btnMixer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎚 Mixer — សំឡេង, EQ &amp; ⏱ Delay (គ្រប់ទូរស័ព្ទ)" />

        <Button
            android:id="@+id/btnAddSongs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ បន្ថែមបទចម្រៀងពីទូរស័ព្ទ" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 ស្វែងរកចម្រៀងលើ YouTube" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/youtubeUrl"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Link YouTube"
                android:inputType="textUri" />

            <Button
                android:id="@+id/btnAddYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➕ YouTube" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="បញ្ជីបទចម្រៀង (ចុចដើម្បីចាក់ · ចុចយូរដើម្បីលុប)"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/playlist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- YouTube search, shown in place of the host panel so the player above stays visible. -->
    <include
        android:id="@+id/searchPanel"
        layout="@layout/panel_search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Client: mixer (volume, EQ, ⏱ delay) -->
    <LinearLayout
        android:id="@+id/clientPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMixerClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎚 Mixer — សំឡេង, EQ &amp; ⏱ Delay" />

    </LinearLayout>
</LinearLayout>

    <!-- Shown only while the current item is a YouTube video. -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="top|start"
        android:background="#000000"
        android:visibility="gone">

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtubeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:enableAutomaticInitialization="false" />

        <!-- Second player that preloads the next song. Kept "visible" but transparent: a hidden
             WebView may stop buffering. The two swap roles when the next song starts. -->
        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtubeView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:alpha="0"
            app:enableAutomaticInitialization="false" />

        <!-- Video files (mp4…) from the library; covers the YouTube players while shown. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone"
            app:resize_mode="fit"
            app:use_controller="false" />

        <!-- "កំពុងទាញយក" with a spinner while the video preloads before everyone starts together. -->
        <LinearLayout
            android:id="@+id/preloadOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:text="កំពុងទាញយក"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- "+15" while skipping (on the tapped side); repeated taps add up. -->
        <TextView
            android:id="@+id/skipOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="28dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Taps / double-taps / drag-down on the video (see MainActivity.playerGestures). -->
        <View
            android:id="@+id/playerTouchGuard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />


        <!-- On-video controls like the YouTube app (tap the video): ⏮ ⏯ ⏭, time, red seek bar. -->
        <FrameLayout
            android:id="@+id/controlsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#59000000"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/overlayButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/ovPrev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/circle_dark"
                android:gravity="center"
                android:text="|◀"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ovPlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/circle_dark"
                android:gravity="center"
                android:text="❚❚"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ovNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/circle_dark"
                android:gravity="center"
                android:text="▶|"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/ovTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="24dp"
                android:background="#80000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0:00 / 0:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:text="⛶"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

        </FrameLayout>

        <!-- Red progress line, always shown; the host can drag its dot (everyone jumps there). -->
        <SeekBar
            android:id="@+id/ovSeek"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="#80FFFFFF"
            android:progressTint="#FF0000"
            android:thumbTint="#FF0000" />

    </FrameLayout>

    <!-- Search screen header: logo, name, text and voice search. Shown only while searching; floats so it can slide
         away while scrolling and come back over the results without pushing them. -->
    <LinearLayout
        android:id="@+id/searchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="4dp"
        android:background="#0F0F0F"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Tap the logo or the name: ℹ about / copyright. -->
            <TextView
                android:id="@+id/headerLogo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/logo_circle"
                android:gravity="center"
                android:text="♫"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="សិង្ហនគរ"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVoice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="🎤"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnSearchToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="🔍"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/search_field"
                android:hint="ស្វែងរកបទចម្រៀង ឬអ្នកចម្រៀង"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <Button
                android:id="@+id/btnGo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="🔍"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>


<!-- Search suggestions while typing; placed over the player and results (below the header). -->
<ListView
    android:id="@+id/suggestionsList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:divider="@null"
    android:visibility="gone" />

<!-- 🎚 Mixer screen, over everything. -->
<include
    android:id="@+id/mixerPanel"
    layout="@layout/panel_mixer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone" />
</FrameLayout>
