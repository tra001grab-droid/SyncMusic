<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 15 draws apps under the status and navigation bars by default, which put the
        search header's 🎤/🔍 and the status line behind the status bar on some phones.
        Keep the normal layout: the app stays between the bars, as on older Android.
    -->
    <style name="Theme.SyncMusic" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
